{
  "name": "procurement-agent",
  "version": "0.1.0",
  "description": "AI agent that pre-checks purchase requests against internal procurement policy and recommends a decision for a human approver.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "procurement-agent": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --project unit --project e2e",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --project e2e --coverage",
    "check": "npm run lint && npm run typecheck && npm test",
    "cli": "tsx src/cli.ts",
    "seed": "tsx src/cli.ts seed",
    "ingest": "tsx src/cli.ts ingest",
    "search": "tsx src/cli.ts search",
    "review": "tsx src/cli.ts review",
    "serve": "tsx src/cli.ts serve",
    "graph:mermaid": "tsx src/cli.ts graph",
    "eval": "tsx evals/runEvals.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@huggingface/transformers": "^4.3.2",
    "@langchain/core": "^1.4.2",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.4",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pgvector": "^0.3.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
