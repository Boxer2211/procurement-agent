# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-opus-5-5
VERIFIER_MODEL=claude-sonnet-5-5
AGENT_EFFORT=medium
VERIFIER_EFFORT=low
# server-side refusal fallback (beta server-side-fallback-2026-07-01); set false on Bedrock/Vertex
LLM_FALLBACKS=true

# --- Storage ---
# postgres (default) or memory (no Docker: BM25 policy search, in-process traces)
STORAGE=postgres
DATABASE_URL=postgresql://procurement:procurement@localhost:5433/procurement
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

# --- Agent limits ---
MAX_ITERATIONS=8
MAX_INPUT_CHARS=4000
RUN_TIMEOUT_S=120
PROMPT_VERSION=v1

# Budget period used by get_budget. Seed data covers 2026-Q4.
# Leave empty to use the current calendar quarter.
BUDGET_PERIOD=2026-Q4

LOG_LEVEL=info
LOG_FORMAT=pretty   # pretty | json
